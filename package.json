{
  "name": "financedesk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:recognition": "node scripts/prepare-local-recognition.mjs",
    "prebuild": "node scripts/prepare-local-recognition.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "test": "npm run test:foundation && npm run test:accounting && npm run test:integration && npm run test:sites",
    "test:accounting": "node --test tests/accounting-classification.test.mjs tests/reconciliation-engine.test.mjs tests/voucher-reporting.test.mjs",
    "test:foundation": "node --test tests/local-foundation.test.mjs tests/bank-intake.test.mjs",
    "test:integration": "node --test tests/product-integration.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "jszip": "^3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "7.0.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  }
}
